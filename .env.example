# LinkedIn credentials - use your personal LinkedIn account
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password

# Optional: If you have 2FA enabled, you may need to use a session cookie instead
# LINKEDIN_JSESSIONID=your_jsessionid
# LINKEDIN_LI_AT=your_li_at_cookie

# Delays (in seconds) - keep these high to avoid LinkedIn rate limits
MIN_DELAY_BETWEEN_ACTIONS=45
MAX_DELAY_BETWEEN_ACTIONS=120
MIN_DELAY_BETWEEN_MESSAGES=60
MAX_DELAY_BETWEEN_MESSAGES=180

# Daily limits - LinkedIn restricts these heavily
MAX_CONNECTION_REQUESTS_PER_DAY=20
MAX_MESSAGES_PER_DAY=50
